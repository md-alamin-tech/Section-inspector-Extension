{
  "manifest_version": 3,
  "name": "Section Code Inspector",
  "version": "1.1",
  "description": "Inspects and copies code from any hovered/selected HTML section. Toggle ON/OFF from the popup.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Section Code Inspector",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
